# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend
RESEND_API_KEY=re_your-api-key

# Trigger.dev
TRIGGER_API_KEY=
TRIGGER_API_URL=

# Vercel KV (Redis)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TRACKING_DOMAIN=http://localhost:3000

# Security
API_KEY_ENCRYPTION_SECRET=generate-a-random-32-byte-hex-string
WEBHOOK_SIGNING_SECRET=generate-a-random-32-byte-hex-string
UNSUBSCRIBE_TOKEN_SECRET=generate-a-random-32-byte-hex-string

# GeoIP (optional)
MAXMIND_LICENSE_KEY=

# Sentry (monitoring)
SENTRY_DSN=
